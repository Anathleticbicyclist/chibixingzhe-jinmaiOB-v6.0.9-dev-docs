<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/grey_light">
 
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:title="@string/app_name"
        app:titleTextColor="@color/white" />
 
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">
 
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
 
            <!-- iGPSPORT -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <View
                            android:layout_width="4dp"
                            android:layout_height="32dp"
                            android:background="@color/igp_green" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="iGPSPORT (迹驰)"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                        <TextView
                            android:id="@+id/tvIgpStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/not_logged_in"
                            android:textColor="@color/red"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnIgpLogin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="登录 iGPSPORT"
                        app:backgroundTint="@color/igp_green" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
 
            <!-- 行者 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <View
                            android:layout_width="4dp"
                            android:layout_height="32dp"
                            android:background="@color/xingzhe_blue" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="行者"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                        <TextView
                            android:id="@+id/tvXingzheStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/not_logged_in"
                            android:textColor="@color/red"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnXingzheLogin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="登录行者"
                        app:backgroundTint="@color/xingzhe_blue" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
 
            <!-- 迈金 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <View
                            android:layout_width="4dp"
                            android:layout_height="32dp"
                            android:background="@color/magene_blue" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="迈金 (顽鹿OTM)"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                        <TextView
                            android:id="@+id/tvMageneStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/not_logged_in"
                            android:textColor="@color/red"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMageneLogin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="登录迈金"
                        app:backgroundTint="@color/magene_blue" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
 
            <!-- Outbase -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <View
                            android:layout_width="4dp"
                            android:layout_height="32dp"
                            android:background="@color/outbase_orange" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="Outbase"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                        <TextView
                            android:id="@+id/tvOutbaseStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/not_logged_in"
                            android:textColor="@color/red"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOutbaseLogin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="登录 Outbase"
                        app:backgroundTint="@color/outbase_orange" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
 
            <!-- 同步设置 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
 
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="同步设置"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />
 
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="同步数量: "
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderCount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:valueFrom="1"
                            android:valueTo="1000"
                            android:stepSize="1"
                            android:value="10"
                            app:thumbColor="@color/primary"
                            app:trackColorActive="@color/primary" />
                        <TextView
                            android:id="@+id/tvCount"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="10"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textColor="@color/primary" />
                    </LinearLayout>
 
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="跳过前: "
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderSkip"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:valueFrom="0"
                            android:valueTo="3000"
                            android:stepSize="1"
                            android:value="0"
                            app:thumbColor="@color/primary"
                            app:trackColorActive="@color/primary" />
                        <TextView
                            android:id="@+id/tvSkip"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textColor="@color/primary" />
                    </LinearLayout>
 
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="数据来源:"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupSource"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipIgp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="iGPSPORT"
                            style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipXingzhe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="行者"
                            android:checked="true"
                            style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipMagene"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="迈金"
                            style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="全部"
                            style="@style/Widget.MaterialComponents.Chip.Choice" />
                    </com.google.android.material.chip.ChipGroup>
 
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="行者GPX自动转FIT(官方转换器)；迈金FIT直链；iGPSPORT原生FIT"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
 
            <!-- 按钮区 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSync"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="🚴 同步到Outbase"
                    android:textSize="13sp"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="12dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTest"
                    android:layout_width="wrap_content"
                    android:layout_height="54dp"
                    android:layout_marginEnd="4dp"
                    android:text="🧪测试"
                    android:textSize="12sp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:cornerRadius="12dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyLog"
                    android:layout_width="wrap_content"
                    android:layout_height="54dp"
                    android:text="📋复制"
                    android:textSize="12sp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:cornerRadius="12dp" />
            </LinearLayout>
 
            <!-- 进度条 -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:visibility="gone"
                app:indicatorColor="@color/primary"
                app:trackColor="@color/grey_light" />
 
            <!-- 运行日志 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="运行日志"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                    <ScrollView
                        android:id="@+id/svLog"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="6dp"
                        android:background="#F0F0F0"
                        android:padding="6dp">
                        <TextView
                            android:id="@+id/tvLog"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="等待操作..."
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:textColor="@color/text_primary" />
                    </ScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
 
            <!-- 鸣谢 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/thanks_platforms"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:gravity="center"
                android:text="@string/thanks_testers"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
 

